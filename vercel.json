{
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    },
    {
      "source": "/api/kk-admin-auth",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, no-cache, must-revalidate, max-age=0" },
        { "key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive" }
      ]
    },
    {
      "source": "/api/kk-admin",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, no-cache, must-revalidate, max-age=0" }
      ]
    },
    {
      "source": "/api/kk-rental-dashboard",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, no-cache, must-revalidate, max-age=0" }
      ]
    },
    {
      "source": "/api/kk-intelligence-health",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, no-cache, must-revalidate, max-age=0" }
      ]
    },
    {
      "source": "/api/kk-data",
      "headers": [
        { "key": "Cache-Control", "value": "s-maxage=15, stale-while-revalidate=45" }
      ]
    },
    {
      "source": "/admin-login.html",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, no-cache, must-revalidate, max-age=0" },
        { "key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive" },
        { "key": "X-Frame-Options", "value": "DENY" }
      ]
    },
    {
      "source": "/admin",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, max-age=0" },
        { "key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive" },
        { "key": "X-Frame-Options", "value": "DENY" }
      ]
    },
    {
      "source": "/admin/",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, max-age=0" },
        { "key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive" },
        { "key": "X-Frame-Options", "value": "DENY" }
      ]
    },
    {
      "source": "/admin/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, no-cache, must-revalidate, max-age=0" },
        { "key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive" },
        { "key": "X-Frame-Options", "value": "DENY" }
      ]
    },
    {
      "source": "/admin/index.html",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, no-cache, must-revalidate, max-age=0" },
        { "key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive" },
        { "key": "X-Frame-Options", "value": "DENY" }
      ]
    },
    {
      "source": "/script.js",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/config.js",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/style.css",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, no-cache, must-revalidate, max-age=0" }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/kk-admin",
      "destination": "/api/kk-admin-session-proxy"
    },
    {
      "source": "/api/kk-rental-dashboard",
      "destination": "/api/kk-rental-dashboard-session-proxy"
    },
    {
      "source": "/",
      "destination": "/index.html"
    },
    {
      "source": "/admin",
      "destination": "/admin-login.html"
    },
    {
      "source": "/admin/",
      "destination": "/admin-login.html"
    },
    {
      "source": "/admin/app",
      "destination": "/api/kk-admin-app"
    },
    {
      "source": "/admin/app/",
      "destination": "/api/kk-admin-app"
    },
    {
      "source": "/admin/:path*",
      "destination": "/api/kk-admin-static?path=:path*"
    }
  ],
  "functions": {
    "api/kk-admin.js": { "maxDuration": 60 },
    "api/kk-admin-guard.js": { "maxDuration": 60 },
    "api/kk-admin-auth.js": { "maxDuration": 10 },
    "api/kk-admin-app.js": { "maxDuration": 10, "includeFiles": "admin/**" },
    "api/kk-admin-static.js": { "maxDuration": 10, "includeFiles": "admin/**" },
    "api/kk-admin-session-proxy.js": { "maxDuration": 60 },
    "api/kk-admin-snapshot-v5.js": { "maxDuration": 60 },
    "api/kk-admin-snapshot-v6.js": { "maxDuration": 60 },
    "api/kk-rental-dashboard-session-proxy.js": { "maxDuration": 60 },
    "api/kk-rental-dashboard-v5.js": { "maxDuration": 60 },
    "api/kk-rental-dashboard-v6.js": { "maxDuration": 60 },
    "api/kk-intelligence-health.js": { "maxDuration": 30 }
  }
}
