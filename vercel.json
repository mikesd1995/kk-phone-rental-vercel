      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, max-age=0"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin"
        },
        {
          "key": "Cross-Origin-Resource-Policy",
          "value": "same-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'none'; script-src 'sha256-Op0jfV7xH7xfnA+siT2hGJ+R8ORlYlvWRploLrfb1ho='; style-src 'self'; connect-src 'self'; img-src 'self'; frame-ancestors 'none'; base-uri 'none'; form-action 'self'"
        }
      ]
    },
    {
      "source": "/admin/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, max-age=0"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin"
        },
        {
          "key": "Cross-Origin-Resource-Policy",
          "value": "same-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'none'; script-src 'sha256-Op0jfV7xH7xfnA+siT2hGJ+R8ORlYlvWRploLrfb1ho='; style-src 'self'; connect-src 'self'; img-src 'self'; frame-ancestors 'none'; base-uri 'none'; form-action 'self'"
        }
      ]
    },
    {
      "source": "/admin/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache, must-revalidate, max-age=0"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "Cross-Origin-Resource-Policy",
          "value": "same-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
        }
      ]
    },
    {
      "source": "/admin/index.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache, must-revalidate, max-age=0"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        }
      ]
    },
    {
      "source": "/script.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/config.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/style.css",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache, must-revalidate, max-age=0"
        }
      ]
    },
    {
      "source": "/api/kk-make-owner-notify",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache, must-revalidate, max-age=0"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/kk-make-owner-notify",
      "destination": "/api/kk-scanner-dispatch?owner_transport=v1"
    },
    {
      "source": "/api/kk-admin",
      "destination": "/api/kk-admin-snapshot-v6"
    },
    {
      "source": "/api/kk-rental-dashboard",
      "destination": "/api/kk-rental-dashboard-v6"
    },
    {
      "source": "/api/kk-admin-auth",
      "destination": "/api/kk-admin-snapshot-v6?__kk_gate=auth"
    },
    {
      "source": "/api/kk-admin-make-verify",
      "destination": "/api/kk-admin-snapshot-v6?__kk_gate=make-verify"
    },
    {
      "source": "/api/kk-admin-make-health",
      "destination": "/api/kk-admin-snapshot-v6?__kk_gate=make-health"
    },
    {
      "source": "/event/:eventId",
      "destination": "/api/kk-data?eventShare=:eventId"
    },
    {
      "source": "/",
      "destination": "/index.html"
    },
    {
      "source": "/admin",
      "destination": "/admin-login.html"
    },
    {
      "source": "/admin/",
      "destination": "/admin-login.html"
    },
    {
      "source": "/admin/app",
      "destination": "/api/kk-admin-snapshot-v6?__kk_gate=app"
    },
    {
      "source": "/admin/app/",
      "destination": "/api/kk-admin-snapshot-v6?__kk_gate=app"
    },
    {
      "source": "/admin/:path*",
      "destination": "/api/kk-admin-snapshot-v6?__kk_gate=asset&path=:path*"
    }
  ],
  "functions": {
    "api/kk-admin-guard.js": {
      "maxDuration": 300
    },
    "api/kk-admin-snapshot-v6.js": {
      "maxDuration": 60,
      "includeFiles": "admin/**"
    },
    "api/kk-rental-dashboard-v6.js": {
      "maxDuration": 60
    },
    "api/kk-intelligence-health.js": {
      "maxDuration": 30
    },
    "api/kk-scanner-dispatch.js": {
      "maxDuration": 300
    }
  },
  "git": {
    "deploymentEnabled": {
      "*": false,
      "main": true
    }
  }
}
