{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kk-scanner-clock",
  "main": "kk-scanner-clock.mjs",
  "compatibility_date": "2026-09-18",
  "triggers": {
    "crons": ["0 * * * *"]
  },
  "vars": {
    "KK_SCANNER_DISPATCH_URL": "https://REPLACE_WITH_PRODUCTION_HOST/api/kk-scanner-dispatch"
  }
}
